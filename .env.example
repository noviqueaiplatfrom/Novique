# Copy to .env and fill in. docker-compose reads these.

# Optional: enables the AI Explainer Engine (Claude). Without it, the pipeline
# falls back to a deterministic heuristic summarizer so the slice still runs.
ANTHROPIC_API_KEY=

# Model used by the summarizer. Default is the most capable model.
# For high-volume ingestion you may prefer claude-haiku-4-5 for cost.
AI_MODEL=claude-opus-4-8

# JWT signing secret for auth. A dev default is baked in, but the backend
# refuses to start with that default unless DEBUG=true — set a strong value
# (>=32 chars) for anything beyond local testing.
JWT_SECRET=

# Local development only. Allows the dev-default JWT_SECRET and prints OTP
# fallback codes to the console. Never set this in a real deployment.
DEBUG=true

# Google OAuth 2.0 Client ID for Frontend Login (Optional)
# Get yours from the Google Cloud Console (https://console.cloud.google.com)
# GOOGLE_CLIENT_ID (backend) must be the SAME value as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID (frontend), or Google Sign-In will reject every
# login — the backend uses it to verify tokens were issued for this app.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Shared secret required in the `x-ingest-secret` header to call
# POST /api/ingest manually. Leave unset to disable the endpoint entirely.
INGEST_SECRET=

# Brevo SMTP Configuration for Two-Factor Authentication (2FA)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@novique.ai
